{
  "name": "neon-snake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --maxWorkers=1 tests/engine.test.js tests/music.test.js tests/interface.test.js",
    "test:unit": "vitest run --maxWorkers=1 tests/engine.test.js tests/music.test.js tests/interface.test.js",
